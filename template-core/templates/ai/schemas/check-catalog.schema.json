{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared check catalog v1",
  "type": "object",
  "required": ["schema_version", "catalog_id", "profile", "policy", "invalidation_paths", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "catalog_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["allow_mandatory_not_applicable"],
      "additionalProperties": false,
      "properties": {"allow_mandatory_not_applicable": {"type": "boolean"}}
    },
    "invalidation_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "run_context": {
      "type": "object", "required": ["events", "network", "network_ttl_seconds"], "additionalProperties": false,
      "properties": {
        "events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["pull_request", "push", "manual", "schedule"]}},
        "network": {"type": "string", "enum": ["disabled", "allowed"]},
        "network_ttl_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "inventory": {
      "type": "object", "required": ["manifest", "expected_steps"], "additionalProperties": false,
      "properties": {"manifest": {"type": "string", "minLength": 1}, "expected_steps": {"type": "integer", "const": 55}}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "argv", "cwd", "mandatory", "timeout_seconds", "prerequisites", "applicability", "expected_artifacts", "dependencies", "allowed_side_effects"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "timeout_seconds": {"type": "integer"},
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "expected_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["candidate_export", "evidence"]}},
          "generated_comparisons": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "provisioning": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "required": ["id", "kind", "dependencies", "network", "ttl_seconds"], "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "const": "npm-ci"}, "kind": {"type": "string", "const": "npm-ci"},
                "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
                "network": {"type": "string", "enum": ["disabled", "allowed"]}, "ttl_seconds": {"type": "integer", "minimum": 1}
              }
            }
          },
          "applicability": {
            "type": "object",
            "properties": {
              "path_exists": {"type": "string", "minLength": 1},
              "missing_status": {"type": "string", "enum": ["NOT_APPLICABLE", "NOT_VERIFIED"]},
              "kind": {"type": "string", "enum": ["always", "path_exists", "changed_any", "event_in", "contract_spec"]},
              "path": {"type": "string", "minLength": 1},
              "prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["pull_request", "push", "manual", "schedule"]}},
              "scaffold_package": {"type": "string", "const": "claude-api-contract"}
            },
            "additionalProperties": false,
            "oneOf": [
              {"type": "object", "required": ["path_exists", "missing_status"]},
              {"type": "object", "required": ["kind"], "properties": {"kind": {"type": "string", "const": "always"}}},
              {"type": "object", "required": ["kind", "path", "missing_status"], "properties": {"kind": {"type": "string", "const": "path_exists"}}},
              {"type": "object", "required": ["kind", "prefixes"], "properties": {"kind": {"type": "string", "const": "changed_any"}}},
              {"type": "object", "required": ["kind", "events"], "properties": {"kind": {"type": "string", "const": "event_in"}}},
              {"type": "object", "required": ["kind", "scaffold_package"], "properties": {"kind": {"type": "string", "const": "contract_spec"}}}
            ]
          }
        }
      }
    }
  }
}
