{
  "schema_version": 1,
  "catalog_id": "contract.current-core",
  "profile": "full",
  "policy": {"allow_mandatory_not_applicable": false},
  "invalidation_paths": [
    "package-lock.json",
    "package.json",
    "docs/ai/production-manifest.json",
    "docs/ai/generated/adapters-manifest.json",
    "docs/ai/core-source.json",
    "template-core/docs/ai/core-manifest.json"
  ],
  "checks": [
    {
      "id": "contract.production-drift",
      "description": "Verify canonical contract production payload generation.",
      "argv": ["{python}", "scripts/ai/production.py", "--check"],
      "cwd": ".",
      "mandatory": true,
      "timeout_seconds": 120,
      "prerequisites": ["python"],
      "applicability": {"path_exists": "scripts/ai/production.py", "missing_status": "NOT_VERIFIED"},
      "expected_artifacts": [],
      "dependencies": [],
      "allowed_side_effects": ["evidence"]
    },
    {
      "id": "contract.adapter-drift",
      "description": "Verify generated runtime adapters against canonical sources.",
      "argv": ["{python}", "scripts/ai/generate_adapters.py", "--check"],
      "cwd": ".",
      "mandatory": true,
      "timeout_seconds": 120,
      "prerequisites": ["python"],
      "applicability": {"path_exists": "scripts/ai/generate_adapters.py", "missing_status": "NOT_VERIFIED"},
      "expected_artifacts": [],
      "dependencies": ["contract.production-drift"],
      "allowed_side_effects": ["evidence"]
    },
    {
      "id": "contract.local-core-drift",
      "description": "Verify owner-local shared-core delivery and receipt drift.",
      "argv": ["{python}", "template-core/scripts/ai/core_sync.py", "--local-source", "--check"],
      "cwd": ".",
      "mandatory": true,
      "timeout_seconds": 120,
      "prerequisites": ["python", "git"],
      "applicability": {"path_exists": "template-core/scripts/ai/core_sync.py", "missing_status": "NOT_VERIFIED"},
      "expected_artifacts": [],
      "dependencies": ["contract.production-drift", "contract.adapter-drift"],
      "allowed_side_effects": ["evidence"]
    }
  ]
}
