{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared check catalog v1",
  "type": "object",
  "required": ["schema_version", "catalog_id", "profile", "policy", "invalidation_paths", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["allow_mandatory_not_applicable"],
      "additionalProperties": false,
      "properties": {"allow_mandatory_not_applicable": {"type": "boolean"}}
    },
    "invalidation_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "argv", "cwd", "mandatory", "timeout_seconds", "prerequisites", "applicability", "expected_artifacts", "dependencies", "allowed_side_effects"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "timeout_seconds": {"type": "integer"},
          "prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "expected_artifacts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowed_side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["candidate_export", "evidence"]}},
          "applicability": {
            "type": "object",
            "required": ["path_exists", "missing_status"],
            "additionalProperties": false,
            "properties": {
              "path_exists": {"type": "string", "minLength": 1},
              "missing_status": {"type": "string", "enum": ["NOT_APPLICABLE", "NOT_VERIFIED"]}
            }
          }
        }
      }
    }
  }
}
