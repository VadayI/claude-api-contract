{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared check result v1",
  "type": "object",
  "required": ["schema_version", "repository", "candidate", "base", "profile", "catalog_id", "digests", "environment", "started_at", "finished_at", "outcome", "checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "repository": {"type": "object", "required": ["name", "identity_sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "identity_sha256": {"type": "string", "minLength": 64}}},
    "candidate": {"type": "object", "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "minLength": 40}, "tree": {"type": "string", "minLength": 40}}},
    "base": {"type": "object", "required": ["commit", "tree"], "properties": {"commit": {"type": "string", "minLength": 40}, "tree": {"type": "string", "minLength": 40}}},
    "profile": {"type": "string", "minLength": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "digests": {"type": "object"},
    "environment": {"type": "object"},
    "started_at": {"type": "integer"},
    "finished_at": {"type": "integer"},
    "outcome": {"type": "string", "enum": ["PASS", "FAIL", "NOT_VERIFIED"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "mandatory", "status", "argv", "cwd"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "status": {"type": "string", "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_VERIFIED"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"}
        }
      }
    }
  }
}
